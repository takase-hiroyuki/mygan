{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cashflow Game Integrated Schema",
  "type": "object",
  "properties": {
    "professions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "initial_cash": { "type": "integer" },
          "salary": { "type": "integer" },
          "expenses": {
            "type": "object",
            "properties": {
              "taxes": { "type": "integer" },
              "home_mortgage_payment": { "type": "integer" },
              "school_loan_payment": { "type": "integer" },
              "car_loan_payment": { "type": "integer" },
              "credit_card_payment": { "type": "integer" },
              "retail_payment": { "type": "integer" },
              "bank_loan_payment": { "type": "integer" },
              "other_expenses": { "type": "integer" },
              "child_expense": { "type": "integer" }
            }
          },
          "liabilities": {
            "type": "object",
            "properties": {
              "home_mortgage": { "type": "integer" },
              "school_loans": { "type": "integer" },
              "car_loans": { "type": "integer" },
              "credit_card_debt": { "type": "integer" },
              "retail_debt": { "type": "integer" }
            }
          }
        }
      }
    },
    "board_settings": {
      "type": "object",
      "properties": {
        "rat_race": {
          "type": "object",
          "properties": {
            "payday_cells": { "type": "array", "items": { "type": "number" } },
            "payday_rule": { "type": "string", "enum": ["passing_or_landing"] }
          }
        }
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "number" },
          "deck_type": { "type": "string", "enum": ["small_deal", "big_deal", "market", "doodad"] },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "symbol": { "type": ["string", "null"] },
          "asset_type": { "type": ["string", "null"], "enum": ["real_estate", "stock", "business", "coin", "none", null] },
          "cost": { "type": ["number", "null"] },
          "down_payment": { "type": ["number", "null"] },
          "mortgage": { "type": ["number", "null"] },
          "passive_income": { "type": ["number", "null"] },
          "is_resellable": { "type": "boolean" },
          "action_rule": {
            "type": ["object", "null"],
            "properties": {
              "type": { "type": "string", "enum": ["multiply_by_child", "stock_split", "stock_reverse_split", "market_sell"] },
              "target_symbol": { "type": "string" },
              "multiplier": { "type": "number" },
              "amount": { "type": "number" },
              "is_loan": { "type": "boolean" },
              "monthly_payment": { "type": "number" },
              "price": { "type": ["number", "string"] }
            }
          }
        }
      }
    },
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "current_turn_user_id": { "type": ["string", "null"] },
          "win_condition_mode": { "type": "string", "enum": ["standard", "double"] },
          "game_state": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "enum": ["waiting", "playing", "ended"] },
              "decks": {
                "type": "object",
                "properties": {
                  "small_deal": { "type": "array", "items": { "type": "number" } },
                  "big_deal": { "type": "array", "items": { "type": "number" } },
                  "market": { "type": "array", "items": { "type": "number" } },
                  "doodad": { "type": "array", "items": { "type": "number" } }
                }
              },
              "graveyard": {
                "type": "object",
                "properties": {
                  "small_deal": { "type": "array", "items": { "type": "number" } },
                  "big_deal": { "type": "array", "items": { "type": "number" } },
                  "market": { "type": "array", "items": { "type": "number" } },
                  "doodad": { "type": "array", "items": { "type": "number" } }
                }
              },
              "current_card": {
                "type": ["object", "null"],
                "properties": {
                  "status": { "type": "string", "enum": ["active", "completed"] },
                  "owner_user_id": { "type": "string" },
                  "card_id": { "type": "number" },
                  "deck_type": { "type": "string", "enum": ["small_deal", "big_deal", "market", "doodad"] },
                  "title": { "type": "string" },
                  "description": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "number" },
          "room_id": { "type": "string" },
          "user_id": { "type": "string" },
          "state": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "role": { "type": "string", "enum": ["general", "host"] },
              "profession": { "type": "string" },
              "game_phase": { "type": "string", "enum": ["rat_race", "fast_track"] },
              "position": { "type": "number" },
              "last_dice": { "type": "number" },
              "calculation_phase": { "type": "string", "enum": ["income_tax", "deal", "none"] },
              "children_count": { "type": "number" },
              "flags": {
                "type": "object",
                "properties": {
                  "charity_turns_left": { "type": "integer", "description": "サイコロ2個振れる残り回数 (0, 1, 2, 3)" },
                  "downsized_turns_left": { "type": "integer", "description": "リストラによる休み残り回数 (0, 1, 2)" },
                  "pending_paydays": { "type": "integer", "description": "未受け取りの給料回数 (0, 1, 2)" },
                  "has_rolled_dice": { "type": "boolean" },
                  "is_card_drawn": { "type": "boolean" },
                  "is_action_completed": { "type": "boolean" },
                  "is_calculating": { "type": "boolean" },
                  "is_negative_cash_flow": { "type": "boolean", "description": "マイナスキャッシュフローの未処理状態を示すフラグ" }
                }
              },
              "financials": {
                "type": "object",
                "properties": {
                  "cash": { "type": "number" },
                  "total_income": { "type": "number" },
                  "total_expenses": { "type": "number" },
                  "passive_income": { "type": "number" },
                  "net_cash_flow": { "type": "number" },
                  "per_child_expense": { "type": "number" },
                  "expenses": {
                    "type": "object",
                    "properties": {
                      "taxes": { "type": "number" },
                      "mortgage_payment": { "type": "number" },
                      "car_loan_payment": { "type": "number" },
                      "loan_interest": { "type": "number" },
                      "child_expense": { "type": "number" },
                      "other": { "type": "number" }
                    }
                  },
                  "assets": {
                    "type": "object",
                    "properties": {
                      "stocks": { "type": "object" },
                      "real_estate": { "type": "array" }
                    }
                  },
                  "liabilities": {
                    "type": "object",
                    "properties": {
                      "mortgage": { "type": "number" },
                      "car_loan": { "type": "number" },
                      "retail_debt": { "type": "number" },
                      "bank_loan": { "type": "number" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "required": ["professions", "board_settings", "cards", "rooms", "participants"]
}
